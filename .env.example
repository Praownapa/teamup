# คัดลอกเป็น .env.local ตอนรัน npm run dev กับ Cognito/backend จริง
VITE_USE_MOCK=false
VITE_API_BASE_URL=/api
VITE_COGNITO_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# cognito = real sign-in (default). local = use the real backend WITHOUT Cognito: any email and
# password works, and the backend must run with AUTH_MODE=dev. Local development only.
VITE_AUTH_MODE=cognito
