# Copy to backend/.env for local development. Never commit .env.
DATABASE_URL=postgresql://teamup:teamup@localhost:5434/teamup
# In AWS the connection comes in parts instead of DATABASE_URL (the password comes from Secrets Manager):
# DB_HOST=...  DB_PORT=5432  DB_NAME=teamup  DB_USER=...  DB_PASSWORD=...  DB_SSLMODE=require

# dev     = accepts test tokens like "dev:john.carter@student.uni.ac.th" (LOCAL ONLY)
# cognito = verifies real Cognito access tokens (the only mode allowed in AWS)
AUTH_MODE=dev
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# off | local (files saved in backend/uploads) | s3 (presigned S3 uploads)
UPLOAD_MODE=local
UPLOAD_DIR=uploads
S3_BUCKET=
S3_REGION=ap-southeast-1
PUBLIC_FILE_BASE_URL=

# Load the demo students and projects on startup when the database is empty
SEED_DEMO_DATA=true

# Email about join requests, invitations and removals (the switches on the Account page):
# off | log (print each email to this terminal instead of sending it) | ses (send through Amazon SES)
EMAIL_MODE=log
EMAIL_FROM=
EMAIL_REGION=ap-northeast-1
# Emails for the made-up demo addresses (@student.uni.ac.th) go here; empty = they aren't sent
EMAIL_DEMO_INBOX=
# The site's address, for the links in emails
APP_URL=http://localhost:5173
